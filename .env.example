# Server
PORT=8000
NODE_ENV=development

# MongoDB (update this with your own connection string)
MONGO_URI=mongodb+srv://Devesh:Devesh@cluster0.wv8ff.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=18h

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Session rules (in hours) - matches business logic in spec
RELOGIN_BLOCK_HOURS=12
AUTO_LOGOUT_HOURS=18

# First superadmin account (used only by npm run seed:superadmin)
# The superadmin then creates admins from the app; each admin creates
# their own employees.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@attendease.com
SUPERADMIN_PASSWORD=SuperAdmin@12345
SUPERADMIN_EMPLOYEE_ID=SA0001
